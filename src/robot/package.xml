<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<!--
format: package.xml의 형식(스키마) 버전을 지정
- 1: ROS 1 초기, 2: ROS 2 후기, 3: ROS 2
-->
<package format="3">
  <name>robot</name>
  <version>0.0.1</version>
  <description>Robot ROS 2 Package</description>

  <maintainer email="your@email.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <!-- 
  <exec_depend>: 이 패키지를 실행할 때 필요한 의존성 설정
  - rclpy: Python으로 ROS2 노드를 만들 수 있게 해주는 라이브러리
  -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>  <!-- 커스텀 서비스 타입 패키지 -->

  <export>
    <!-- 이 패키지는 ament_python 빌드 시스템으로 빌드 -->
    <build_type>ament_python</build_type>
  </export>
</package>
